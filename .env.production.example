# ==========================================
# LMS Platform - Production Environment Configuration
# ==========================================

APP_NAME="Classroom Hub"
APP_ENV=production
APP_KEY=base64:CkeXb/HvXz2iFqfh2ijkXTRdeDAB5eDi1oO+Np091ec=
APP_DEBUG=false
APP_URL=https://your-lms-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------
# Primary Relational Database (Core Academic Data)
# ------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_core_production
DB_USERNAME=lms_user
DB_PASSWORD="ChangeThisStrongPassword123!"

# ------------------------------------------
# Optional Isolated Chat Database (High-Frequency Messaging)
# Leave blank to use primary DB, or configure to isolate chat load:
# ------------------------------------------
DB_CHAT_CONNECTION=
# DB_CHAT_HOST=127.0.0.1
# DB_CHAT_PORT=3306
# DB_CHAT_DATABASE=lms_chat_production
# DB_CHAT_USERNAME=lms_chat_user
# DB_CHAT_PASSWORD="ChangeThisStrongPassword123!"

# ------------------------------------------
# Cache, Session, & Queue Drivers
# ------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# If using Redis in production:
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ------------------------------------------
# Real-Time WebSockets (Laravel Reverb)
# ------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=782194
REVERB_APP_KEY=1msoak4p9kgh81lmskey
REVERB_APP_SECRET=sec92184lmssec9921
REVERB_HOST="your-lms-domain.com"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------
# File Storage (Local or Cloudflare R2 / AWS S3)
# ------------------------------------------
FILESYSTEM_DISK=public

# When switching to Cloudflare R2 / AWS S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=lms-materials
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------
# Mail Settings (Transactional Notifications)
# ------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-lms-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
